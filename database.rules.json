{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$seed": {
        ".read": true,
        ".write": "!data.exists() || (newData.exists() && newData.child('hostKey').val() === data.child('hostKey').val() && newData.child('createdAt').val() === data.child('createdAt').val())",
        ".validate": "newData.hasChildren(['createdAt', 'hostKey', 'topic', 'status'])",
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "hostKey": {
          ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
        },
        "topic": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "status": {
          ".validate": "(newData.val() === 'lobby' || newData.val() === 'voting' || newData.val() === 'results') && (!data.exists() || newData.val() === data.val() || (data.val() === 'lobby' && newData.val() === 'voting') || (data.val() === 'voting' && newData.val() === 'results') || (data.val() === 'results' && newData.val() === 'lobby'))"
        },
        "autoCloseAt": {
          ".validate": "newData.isNumber()"
        },
        "closeReason": {
          ".validate": "newData.val() === 'all-voted' || newData.val() === 'host'"
        },
        "voters": {
          "$voterId": {
            ".validate": "newData.hasChildren(['joinedAt']) && $voterId.length <= 64",
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "vote": {
              ".validate": "(newData.val() === 'yes' || newData.val() === 'no' || newData.val() === 'abstain') && ((data.exists() && newData.val() === data.val()) || (!data.exists() && newData.parent().parent().parent().child('status').val() === 'voting'))"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
